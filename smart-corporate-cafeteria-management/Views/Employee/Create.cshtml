@model smart_corporate_cafeteria_management.Models.Employee

@{
    ViewData["Title"] = "Add Employee";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Add New Employee</h2>
            <p class="text-muted mb-0">
                Create a new employee profile in the system.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Employees
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8 col-xl-7">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-white border-0 px-4 pt-4">
                    <div class="d-flex align-items-center">
                        <div class="rounded-3 bg-primary bg-opacity-10 p-3 me-3">
                            <i class="bi bi-person-plus fs-3 text-primary"></i>
                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">Employee Information</h5>
                            <small class="text-muted">
                                Enter the employee's details below.
                            </small>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">

                    <form asp-action="Create" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert"></div>

                        <!-- Employee Name -->
                        <div class="mb-4">
                            <label asp-for="EmployeeName"
                                   class="form-label fw-semibold">
                                Employee Name
                                <span class="text-danger">*</span>
                            </label>

                            <input asp-for="EmployeeName"
                                   class="form-control form-control-lg"
                                   placeholder="Enter full employee name" />

                            <span asp-validation-for="EmployeeName"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Email -->
                        <div class="mb-4">
                            <label asp-for="Email"
                                   class="form-label fw-semibold">
                                Email Address
                                <span class="text-danger">*</span>
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control form-control-lg"
                                   placeholder="example@company.com" />

                            <span asp-validation-for="Email"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Phone -->
                        <div class="mb-4">
                            <label asp-for="Phone"
                                   class="form-label fw-semibold">
                                Phone Number
                            </label>

                            <input asp-for="Phone"
                                   class="form-control form-control-lg"
                                   placeholder="Enter phone number" />

                            <span asp-validation-for="Phone"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Department -->
                        <div class="mb-4">
                            <label asp-for="DepartmentId"
                                   class="form-label fw-semibold">
                                Department
                                <span class="text-danger">*</span>
                            </label>

                            <select asp-for="DepartmentId"
                                    asp-items="ViewBag.Departments"
                                    class="form-select form-select-lg">

                                <option value="">Select Department</option>

                            </select>

                            <span asp-validation-for="DepartmentId"
                                  class="text-danger small"></span>
                        </div>

                        <hr class="my-4" />

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-light border px-4">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                <i class="bi bi-person-check me-2"></i>
                                Save Employee
                            </button>

                        </div>

                    </form>

                </div>
            </div>

            <div class="text-muted small mt-3">
                <i class="bi bi-info-circle me-1"></i>
                Fields marked with * are required.
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
