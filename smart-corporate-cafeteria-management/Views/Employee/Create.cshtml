@model smart_corporate_cafeteria_management.Models.Employee

@{
    ViewData["Title"] = "Add New Employee";
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-person-plus-fill text-success me-2"></i>
                Add New Employee
            </h2>
            <p class="text-muted mb-0">
                Register a new employee in the cafeteria system.
            </p>
        </div>

        <a asp-controller="Employee"
           asp-action="Index"
           class="btn btn-outline-secondary mt-3 mt-md-0">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Employees
        </a>
    </div>

    <!-- Registration Form -->
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="mb-4">
                        <h5 class="fw-bold mb-1">
                            Employee Information
                        </h5>
                        <p class="text-muted small mb-0">
                            Enter the employee's personal and department information.
                        </p>
                    </div>

                    <form asp-controller="Employee"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>

                        <!-- Employee Name -->
                        <div class="mb-3">
                            <label asp-for="EmployeeName"
                                   class="form-label fw-semibold">
                                Employee Name
                            </label>

                            <input asp-for="EmployeeName"
                                   class="form-control form-control-lg"
                                   placeholder="Enter full name" />

                            <span asp-validation-for="EmployeeName"
                                  class="text-danger small">
                            </span>
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="Email"
                                   class="form-label fw-semibold">
                                Email Address
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control form-control-lg"
                                   placeholder="name@company.com" />

                            <span asp-validation-for="Email"
                                  class="text-danger small">
                            </span>
                        </div>

                        <!-- Phone -->
                        <div class="mb-3">
                            <label asp-for="Phone"
                                   class="form-label fw-semibold">
                                Phone Number
                            </label>

                            <input asp-for="Phone"
                                   class="form-control form-control-lg"
                                   placeholder="01XXXXXXXXX" />

                            <span asp-validation-for="Phone"
                                  class="text-danger small">
                            </span>
                        </div>

                        <!-- Department -->
                        <div class="mb-4">
                            <label asp-for="DepartmentId"
                                   class="form-label fw-semibold">
                                Department
                            </label>

                            <select asp-for="DepartmentId"
                                    asp-items="ViewBag.Departments"
                                    class="form-select form-select-lg">

                                <option value="0">
                                    -- Select Department --
                                </option>

                            </select>

                            <span asp-validation-for="DepartmentId"
                                  class="text-danger small">
                            </span>
                        </div>

                        <!-- Information -->
                        <div class="alert alert-info rounded-3">
                            <i class="bi bi-info-circle-fill me-2"></i>
                            Employee ID will be generated automatically
                            after successful registration.
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex flex-wrap gap-2">

                            <button type="submit"
                                    class="btn btn-success btn-lg px-4">

                                <i class="bi bi-person-check-fill me-2"></i>
                                Save Employee

                            </button>

                            <a asp-controller="Employee"
                               asp-action="Index"
                               class="btn btn-outline-secondary btn-lg">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
