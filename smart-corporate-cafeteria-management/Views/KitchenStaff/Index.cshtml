@{
    ViewData["Title"] = "Kitchen Dashboard";

    var todayMenuItems = ViewBag.TodayMenuItems as List<string>
                         ?? new List<string>();

    int totalRecipes = ViewBag.TotalRecipes ?? 0;
    int todayCollections = ViewBag.TodayCollections ?? 0;
    int menuItemsCount = ViewBag.TodayMenuItemsCount ?? 0;

    bool menuAvailable = ViewBag.MenuAvailable ?? false;
}

<style>
    .kitchen-page {
        color: #293B30;
    }

    .welcome-panel {
        background: linear-gradient(120deg, #244B36, #386448);
        color: white;
        padding: 30px;
        border-radius: 16px;
        margin-bottom: 25px;
    }

        .welcome-panel h2 {
            font-size: 25px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .welcome-panel p {
            color: #DCE9DF;
            margin: 0;
            font-size: 14px;
        }

    .kitchen-card,
    .section-card {
        background: white;
        border: 1px solid #EEE8E2;
        border-radius: 13px;
        padding: 21px;
        height: 100%;
        box-shadow: 0 3px 12px rgba(0,0,0,0.025);
    }

    .kitchen-icon {
        width: 45px;
        height: 45px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
        margin-bottom: 16px;
    }

    .kitchen-card h3 {
        font-size: 25px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .kitchen-card p {
        color: #8B817A;
        font-size: 12px;
        margin: 0;
    }

    .section-title {
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 18px;
    }

    .task-item {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 13px 0;
        border-bottom: 1px solid #F1ECE7;
    }

        .task-item:last-child {
            border-bottom: none;
        }

    .task-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #FCE8DC;
        color: #A94730;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        flex-shrink: 0;
    }

    .task-item strong {
        display: block;
        font-size: 13px;
    }

    .task-item small {
        color: #8B817A;
        font-size: 11px;
    }

    .menu-food {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 13px;
        background: #EAF3EC;
        color: #315C40;
        border-radius: 20px;
        margin: 0 6px 9px 0;
        font-size: 12px;
        font-weight: 600;
    }

    .kitchen-note {
        background: #FFF5E8;
        border: 1px solid #F3DFC1;
        padding: 16px;
        border-radius: 11px;
        color: #76552F;
        font-size: 12px;
    }

    .status-label {
        display: inline-block;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

    .status-available {
        background: #E5F1E8;
        color: #386448;
    }

    .status-unavailable {
        background: #FFF0E8;
        color: #A94730;
    }
</style>

<div class="kitchen-page">

    <!-- WELCOME PANEL -->
    <div class="welcome-panel">

        <div class="d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-cup-hot-fill fs-3"></i>
            <span class="small">KITCHEN MANAGEMENT</span>
        </div>

        <h2>Welcome to the Kitchen! 👨‍🍳</h2>

        <p>
            Manage daily food preparation, recipes and kitchen operations
            from one place.
        </p>

        <div class="mt-3 small">
            <i class="bi bi-calendar3 me-2"></i>
            @DateTime.Today.ToString("dddd, dd MMMM yyyy")
        </div>

    </div>

    <!-- SUMMARY CARDS -->
    <div class="row g-3 mb-4">

        <div class="col-md-6 col-xl-3">
            <div class="kitchen-card">

                <div class="kitchen-icon"
                     style="background:#E5F1E8;color:#386448;">
                    <i class="bi bi-calendar-check"></i>
                </div>

                <h3>@menuItemsCount</h3>
                <p>Today's Menu Items</p>

            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="kitchen-card">

                <div class="kitchen-icon"
                     style="background:#FCE8DC;color:#A94730;">
                    <i class="bi bi-people"></i>
                </div>

                <h3>@todayCollections</h3>
                <p>Today's Meal Collections</p>

            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="kitchen-card">

                <div class="kitchen-icon"
                     style="background:#E8EDFA;color:#5266A5;">
                    <i class="bi bi-journal-text"></i>
                </div>

                <h3>@totalRecipes</h3>
                <p>Available Recipes</p>

            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="kitchen-card">

                <div class="kitchen-icon"
                     style="background:#FFF1D9;color:#A87924;">
                    <i class="bi bi-box-seam"></i>
                </div>

                <h3>—</h3>
                <p>Inventory Overview</p>

            </div>
        </div>

    </div>

    <!-- MAIN SECTIONS -->
    <div class="row g-3">

        <!-- TODAY'S MENU -->
        <div class="col-lg-7">

            <div class="section-card">

                <div class="d-flex justify-content-between
                    align-items-center mb-3">

                    <h5 class="section-title mb-0">
                        <i class="bi bi-calendar3 me-2"></i>
                        Today's Food Menu
                    </h5>

                    @if (menuAvailable)
                    {
                        <span class="status-label status-available">
                            Available
                        </span>
                    }
                    else
                    {
                        <span class="status-label status-unavailable">
                            Not Published
                        </span>
                    }

                </div>

                @if (menuAvailable && todayMenuItems.Any())
                {
                    <p class="text-muted small mb-3">
                        Today's scheduled food items:
                    </p>

                    <div>
                        @foreach (var food in todayMenuItems)
                        {
                            <span class="menu-food">
                                <i class="bi bi-check-circle-fill"></i>
                                @food
                            </span>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4">

                        <i class="bi bi-calendar-x fs-1 text-muted"></i>

                        <h6 class="mt-3">
                            No Menu Available Today
                        </h6>

                        <p class="text-muted small mb-0">
                            Today's menu has not been added or published yet.
                        </p>

                    </div>
                }

                <hr class="my-4" />

                <div class="small text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    Menu information is retrieved from the database.
                </div>

            </div>

        </div>

        <!-- KITCHEN GUIDELINES -->
        <div class="col-lg-5">

            <div class="section-card">

                <h5 class="section-title">
                    <i class="bi bi-lightbulb me-2"></i>
                    Kitchen Guidelines
                </h5>

                <div class="kitchen-note mb-3">
                    <i class="bi bi-info-circle me-2"></i>
                    Check the daily menu before starting food preparation.
                </div>

                <div class="kitchen-note mb-3">
                    <i class="bi bi-box-seam me-2"></i>
                    Verify ingredient availability before cooking.
                </div>

                <div class="kitchen-note">
                    <i class="bi bi-check-circle me-2"></i>
                    Maintain food quality and hygiene during preparation.
                </div>

            </div>

        </div>

        <!-- KITCHEN OPERATIONS -->
        <div class="col-lg-7">

            <div class="section-card">

                <h5 class="section-title">
                    <i class="bi bi-list-check me-2"></i>
                    Kitchen Operations
                </h5>

                <div class="task-item">
                    <div class="task-icon">
                        <i class="bi bi-calendar3"></i>
                    </div>
                    <div>
                        <strong>Daily Menu</strong>
                        <small>View today's food menu</small>
                    </div>
                </div>

                <div class="task-item">
                    <div class="task-icon">
                        <i class="bi bi-journal-bookmark"></i>
                    </div>
                    <div>
                        <strong>Recipe Management</strong>
                        <small>View recipes and ingredients</small>
                    </div>
                </div>

                <div class="task-item">
                    <div class="task-icon">
                        <i class="bi bi-clipboard-check"></i>
                    </div>
                    <div>
                        <strong>Meal Preparation</strong>
                        <small>Manage daily kitchen preparation</small>
                    </div>
                </div>

                <div class="task-item">
                    <div class="task-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <div>
                        <strong>Inventory Overview</strong>
                        <small>Check available ingredients and stock</small>
                    </div>
                </div>

                <div class="task-item">
                    <div class="task-icon">
                        <i class="bi bi-qr-code"></i>
                    </div>
                    <div>
                        <strong>Meal Collection</strong>
                        <small>View employee meal collection information</small>
                    </div>
                </div>

            </div>

        </div>

        <!-- RECIPIO -->
        <div class="col-lg-5">

            <div class="section-card">

                <h5 class="section-title">
                    <i class="bi bi-robot me-2"></i>
                    Recipio AI Assistant
                </h5>

                <p class="text-muted small">
                    Your future AI kitchen assistant will help with recipes,
                    ingredients and kitchen-related questions.
                </p>

                <span class="badge rounded-pill text-bg-warning">
                    Coming Soon
                </span>

            </div>

        </div>

    </div>

</div>
