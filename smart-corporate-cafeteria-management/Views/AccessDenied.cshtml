@{
    ViewData["Title"] = "Access Denied";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Access Denied | Smart Cafeteria</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #faf8f0;
            font-family: Arial, sans-serif;
        }

        .denied-card {
            max-width: 480px;
            width: 92%;
            padding: 45px 35px;
            text-align: center;
            background: white;
            border-radius: 20px;
            box-shadow: 0 12px 40px rgba(0,0,0,.07);
        }

        .icon {
            font-size: 65px;
            margin-bottom: 20px;
        }

        h2 {
            color: #286344;
            font-weight: 700;
        }

        p {
            color: #78847a;
            line-height: 1.7;
        }

        .btn-home {
            background: #286344;
            color: white;
            border-radius: 10px;
            padding: 12px 25px;
            text-decoration: none;
            display: inline-block;
            margin-top: 15px;
        }

            .btn-home:hover {
                background: #194b32;
                color: white;
            }
    </style>
</head>

<body>
    <div class="denied-card">

        <div class="icon">🔒</div>

        <h2>Access Denied</h2>

        <p class="mt-3">
            Sorry! You don't have permission to access this page.
            Please contact your system administrator if you
            believe this is a mistake.
        </p>

        <a asp-controller="Account"
           asp-action="Login"
           class="btn-home">
            Back to Login →
        </a>

    </div>
</body>
</html>
