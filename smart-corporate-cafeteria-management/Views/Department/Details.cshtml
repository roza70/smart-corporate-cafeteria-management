@model smart_corporate_cafeteria_management.Models.Department

@{
    ViewData["Title"] = "Department Details";
}

<h1>Department Details</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <dl class="row">

            <dt class="col-sm-4">
                Department ID
            </dt>
            <dd class="col-sm-8">
                @Model.DepartmentId
            </dd>

            <dt class="col-sm-4">
                Department Name
            </dt>
            <dd class="col-sm-8">
                @Model.DepartmentName
            </dd>

            <dt class="col-sm-4">
                Description
            </dt>
            <dd class="col-sm-8">
                @(string.IsNullOrWhiteSpace(Model.Description)
                    ? "No description available"
                    : Model.Description)
            </dd>

            <dt class="col-sm-4">
                Employee Count
            </dt>
            <dd class="col-sm-8">
                @(Model.Employees?.Count ?? 0)
            </dd>

        </dl>

        <div class="mt-3">

            <a asp-action="Edit"
               asp-route-id="@Model.DepartmentId"
               class="btn btn-warning">
                Edit Department
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back to List
            </a>

        </div>

    </div>
</div>
