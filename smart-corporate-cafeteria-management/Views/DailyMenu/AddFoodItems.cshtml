@model smart_corporate_cafeteria_management.ViewModels.AddFoodItemsViewModel

@{
    ViewData["Title"] = "Add Food Items";
}

<div class="container-fluid mt-4">

    <div class="mb-4">
        <h2 class="fw-bold">Daily Menu Food Selection</h2>
        <p class="text-muted">
            Select one food item from each category for your cafeteria menu.
        </p>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">

            <form asp-controller="DailyMenu"
                  asp-action="AddFoodItems"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="MenuID" />
                <input type="hidden" asp-for="MenuDate" />

                <div asp-validation-summary="All"
                     class="alert alert-danger">
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">
                        Menu Date
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.MenuDate.ToString("dd MMMM yyyy")"
                           readonly />
                </div>

                @for (int i = 0; i < Model.CategorySelections.Count; i++)
                {
                    var category = Model.CategorySelections[i];

                    <div class="card border mb-4">

                        <div class="card-header bg-light py-3">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                                <h5 class="mb-0 fw-bold">
                                    @(i + 1). @category.CategoryName
                                </h5>

                                <a asp-controller="FoodItem"
                                   asp-action="Create"
                                   asp-route-categoryId="@category.CategoryID"
                                   asp-route-returnTo="@Url.Action("AddFoodItems", "DailyMenu", new { id = Model.MenuID })"
                                   class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-plus-circle me-1"></i>
                                    Add New Food Item
                                </a>

                            </div>
                        </div>

                        <div class="card-body">

                            <input type="hidden"
                                   name="CategorySelections[@i].CategoryID"
                                   value="@category.CategoryID" />

                            <input type="hidden"
                                   name="CategorySelections[@i].CategoryName"
                                   value="@category.CategoryName" />

                            @if (category.AvailableFoodItems.Any())
                            {
                                <div class="row">

                                    @foreach (var food in category.AvailableFoodItems)
                                    {
                                        var radioId = $"food_{i}_{food.FoodItemId}";

                                        <div class="col-md-6 col-lg-4 mb-3">

                                            <div class="form-check border rounded p-3">

                                                <input class="form-check-input"
                                                       type="radio"
                                                       name="CategorySelections[@i].SelectedFoodItemId"
                                                       id="@radioId"
                                                       value="@food.FoodItemId"
                                                       checked="@(category.SelectedFoodItemId == food.FoodItemId ? "checked" : null)"
                                                       required />

                                                <label class="form-check-label fw-semibold"
                                                       for="@radioId">
                                                    @food.FoodName
                                                </label>

                                            </div>

                                        </div>
                                    }

                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0">
                                    No active food items available in this category.
                                    Please add food items first.
                                </div>
                            }

                            <span asp-validation-for="CategorySelections[i].SelectedFoodItemId"
                                  class="text-danger">
                            </span>

                        </div>
                    </div>
                }

                <div class="d-flex gap-2 flex-wrap">

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-check-circle me-2"></i>
                        Save Daily Menu
                    </button>

                    <a asp-controller="DailyMenu"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
