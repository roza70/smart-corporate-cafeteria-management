@model smart_corporate_cafeteria_management.Models.Department

@{
    ViewData["Title"] = "Edit Department";
}

<h1>Edit Department</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Edit"
              asp-route-id="@Model.DepartmentId"
              method="post">

            <input type="hidden" asp-for="DepartmentId" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="DepartmentName"
                       class="control-label">
                    Department Name
                </label>

                <input asp-for="DepartmentName"
                       class="form-control" />

                <span asp-validation-for="DepartmentName"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description"
                       class="control-label">
                    Description
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="3"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit"
                        class="btn btn-primary">
                    Update Department
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Back to List
                </a>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
