
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Smart Cafeteria</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="~/smart_corporate_cafeteria_management.styles.css"
          asp-append-version="true" />

    <style>
        :root {
            --sidebar-bg: #A94730;
            --sidebar-hover: #8F3B29;
            --primary: #783020;
            --page-bg: #FFF8F2;
            --text-main: #293B30;
            --text-muted: #8B817A;
            --accent-orange: #F4B183;
            --accent-cream: #FCE8DC;
            --forest-green: #244B36;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--page-bg);
            color: var(--text-main);
            font-family: Inter, "Segoe UI", Arial, sans-serif;
        }

        .app-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* =========================
                           SIDEBAR
                ========================= */

        .sidebar {
            width: 255px;
            min-width: 255px;
            background: linear-gradient(180deg, #A94730 0%, #873A29 100%);
            color: white;
            padding: 25px 16px;
            display: flex;
            flex-direction: column;
        }

        /* Brand */

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 10px 30px;
            color: white;
            text-decoration: none;
        }

            .brand:hover {
                color: white;
            }

        .brand-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: var(--accent-orange);
            color: #71301F;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }

        .brand-name {
            font-size: 15px;
            font-weight: 700;
            line-height: 1.4;
        }

            .brand-name small {
                display: block;
                color: #F5D1C2;
                font-size: 11px;
                font-weight: 400;
            }

        /* Sidebar Section Labels */

        .sidebar-label {
            color: #F3C5B3;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.2px;
            padding: 15px 12px 9px;
        }

        /* Sidebar Navigation */

        .sidebar nav {
            display: flex;
            flex-direction: column;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 13px;
            margin: 3px 0;
            border-radius: 9px;
            color: #FBECE5;
            text-decoration: none;
            font-size: 13px;
            transition: all 0.2s ease;
        }

            .sidebar-link i {
                font-size: 17px;
            }

            .sidebar-link:hover {
                background: rgba(255, 255, 255, 0.13);
                color: #FFFFFF;
            }

            .sidebar-link.active {
                background: #783020;
                color: #FFFFFF;
                font-weight: 600;
                box-shadow: inset 3px 0 0 #F4B183;
            }

            .sidebar-link.disabled {
                opacity: 0.55;
                cursor: default;
            }

        .coming-soon {
            margin-left: auto;
            font-size: 9px;
            color: #F5C9B7;
        }

        /* Sidebar Footer */

        .sidebar-bottom {
            margin-top: auto;
            padding: 18px 10px 0;
            border-top: 1px solid rgba(255, 255, 255, 0.2);
            color: #F5D1C2;
            font-size: 11px;
        }

        /* =========================
                           MAIN AREA
                ========================= */

        .main-area {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
        }

        /* Top Navigation */

        .topbar {
            min-height: 72px;
            background: #FFFFFF;
            border-bottom: 1px solid #EEE8E2;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 30px;
            gap: 15px;
        }

        .topbar-title {
            font-size: 18px;
            font-weight: 700;
            margin: 0;
            color: var(--forest-green);
        }

        .topbar-subtitle {
            color: var(--text-muted);
            font-size: 11px;
            margin-top: 3px;
        }

        /* Admin Profile */

        .admin-profile {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
        }

        .profile-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #FCE8DC;
            color: #A94730;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
        }

        .profile-name {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-main);
        }

        .profile-role {
            display: block;
            color: var(--text-muted);
            font-size: 10px;
            font-weight: 400;
        }

        /* Logout Button */

        .logout-form {
            margin-left: 12px;
        }

        .logout-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 16px;
            border: 1px solid #F1D5CA;
            border-radius: 9px;
            background: #FFF5F0;
            color: #A94730;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .logout-button:hover {
                background: #A94730;
                color: white;
                border-color: #A94730;
            }

            .logout-button i {
                font-size: 15px;
            }

        /* Page Content */

        .page-content {
            width: 100%;
            max-width: 1600px;
            padding: 30px;
            margin: 0 auto;
            flex: 1;
        }

        /* Footer */

        .app-footer {
            padding: 16px 30px;
            color: var(--text-muted);
            font-size: 11px;
            border-top: 1px solid #EEE8E2;
            background: white;
        }

        /* =========================
                           RESPONSIVE DESIGN
                ========================= */

        @@media (max-width: 768px) {

            .app-wrapper {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
                min-width: 100%;
                padding: 14px;
                background: linear-gradient(120deg, #A94730, #873A29);
            }

            .brand {
                padding: 0 5px 12px;
            }

            .sidebar-label,
            .sidebar-bottom {
                display: none;
            }

            .sidebar nav {
                display: flex;
                flex-direction: row;
                flex-wrap: wrap;
            }

            .sidebar-link {
                display: inline-flex;
                padding: 9px 11px;
                margin: 2px;
            }

            .topbar {
                padding: 12px 16px;
                min-height: 62px;
            }

            .topbar-title {
                font-size: 16px;
            }

            .page-content {
                padding: 18px 12px;
            }

            .app-footer {
                padding: 14px;
            }
        }

        @@media (max-width: 520px) {

            .topbar {
                align-items: flex-start;
                flex-direction: column;
            }

            .admin-profile {
                width: 100%;
                justify-content: flex-end;
            }

            .logout-form {
                margin-left: auto;
            }
        }

        @@media (max-width: 420px) {

            .admin-profile {
                gap: 6px;
            }

            .profile-name {
                font-size: 10px;
            }

            .profile-avatar {
                width: 32px;
                height: 32px;
            }

            .topbar-subtitle {
                font-size: 9px;
            }

            .logout-button {
                padding: 8px 12px;
                font-size: 11px;
            }
        }
    </style>
</head>

<body>

    @{
        var currentController =
            ViewContext.RouteData.Values["controller"]?.ToString();
    }

    <div class="app-wrapper">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <!-- BRAND -->
            <a asp-controller="Dashboard"
               asp-action="Index"
               class="brand">

                <div class="brand-icon">
                    <i class="bi bi-cup-hot-fill"></i>
                </div>

                <div class="brand-name">
                    Smart Cafeteria
                    <small>Management System</small>
                </div>

            </a>

            <!-- MAIN MENU -->
            <div class="sidebar-label">MAIN MENU</div>

            <nav>

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Dashboard" ? "active" : "")">

                    <i class="bi bi-grid-1x2-fill"></i>
                    Dashboard

                </a>

                <a asp-controller="Employee"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Employee" ? "active" : "")">

                    <i class="bi bi-people-fill"></i>
                    Employees

                </a>

                <a asp-controller="Department"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "Department" ? "active" : "")">

                    <i class="bi bi-diagram-3-fill"></i>
                    Departments

                </a>

            </nav>

            <!-- CAFETERIA OPERATIONS -->
            <div class="sidebar-label">CAFETERIA OPERATIONS</div>

            <nav>

                <!-- FOOD CATEGORIES -->
                <a asp-controller="FoodCategory"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "FoodCategory" ? "active" : "")">

                    <i class="bi bi-tags-fill"></i>
                    Food Categories

                </a>

                <!-- FOOD ITEMS -->
                <a asp-controller="FoodItem"
                   asp-action="Index"
                   class="sidebar-link @(currentController == "FoodItem" ? "active" : "")">

                    <i class="bi bi-egg-fried"></i>
                    Food Items

                </a>

                <!-- DAILY MENU -->
                <span class="sidebar-link disabled">
                    <i class="bi bi-calendar3"></i>
                    Daily Menu
                    <small class="coming-soon">Soon</small>
                </span>

                <!-- MEAL COLLECTION -->
                <span class="sidebar-link disabled">
                    <i class="bi bi-qr-code"></i>
                    Meal Collection
                    <small class="coming-soon">Soon</small>
                </span>

                <!-- KITCHEN MANAGEMENT -->
                <span class="sidebar-link disabled">
                    <i class="bi bi-clipboard-check"></i>
                    Kitchen Management
                    <small class="coming-soon">Soon</small>
                </span>

                <!-- INVENTORY -->
                <span class="sidebar-link disabled">
                    <i class="bi bi-box-seam"></i>
                    Inventory
                    <small class="coming-soon">Soon</small>
                </span>

                <!-- SUPPLIERS -->
                <span class="sidebar-link disabled">
                    <i class="bi bi-truck"></i>
                    Suppliers
                    <small class="coming-soon">Soon</small>
                </span>

            </nav>

            <!-- MANAGEMENT -->
            <div class="sidebar-label">MANAGEMENT</div>

            <nav>

                <span class="sidebar-link disabled">
                    <i class="bi bi-bar-chart-fill"></i>
                    Reports & Analytics
                    <small class="coming-soon">Soon</small>
                </span>

                <span class="sidebar-link disabled">
                    <i class="bi bi-gear-fill"></i>
                    Settings
                    <small class="coming-soon">Soon</small>
                </span>

            </nav>

            <!-- SIDEBAR FOOTER -->
            <div class="sidebar-bottom">

                <i class="bi bi-shield-check me-1"></i>

                Smart Corporate Cafeteria

                <br />

                <span>Version 1.0</span>

            </div>

        </aside>

        <!-- MAIN CONTENT -->
        <div class="main-area">

            <!-- TOPBAR -->
            <header class="topbar">

                <div>

                    <h1 class="topbar-title">
                        @(ViewData["Title"] ?? "Dashboard")
                    </h1>

                    <div class="topbar-subtitle">
                        Smart Corporate Cafeteria Management System
                    </div>

                </div>

                <!-- ADMIN PROFILE AND LOGOUT -->
                <div class="admin-profile">

                    <div class="profile-avatar">
                        A
                    </div>

                    <div class="profile-name">

                        Administrator

                        <span class="profile-role">
                            System Admin
                        </span>

                    </div>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="logout-form">

                            @Html.AntiForgeryToken()

                            <button type="submit" class="logout-button">
                                <i class="bi bi-box-arrow-right"></i>
                                Logout
                            </button>

                        </form>
                    }

                </div>

            </header>

            <!-- PAGE CONTENT -->
            <main role="main" class="page-content">
                @RenderBody()
            </main>

            <!-- FOOTER -->
            <footer class="app-footer">

                © 2026 Smart Corporate Cafeteria Management System.
                All rights reserved.

            </footer>

        </div>

    </div>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
