@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">

    <!-- Dashboard Header -->
    <div class="mb-4">
        <h2 class="fw-bold">Admin Dashboard</h2>
        <p class="text-muted">
            Welcome to Smart Corporate Cafeteria Management System.
            Manage your cafeteria operations from here.
        </p>
    </div>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">

        <!-- Total Employees -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted">Total Employees</h6>
                            <h2 class="fw-bold mb-0">
                                @ViewBag.TotalEmployees
                            </h2>
                        </div>
                        <div class="fs-1 text-primary">
                            <i class="bi bi-people-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Departments -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted">Departments</h6>
                            <h2 class="fw-bold mb-0">
                                @ViewBag.Departments
                            </h2>
                        </div>
                        <div class="fs-1 text-success">
                            <i class="bi bi-building"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Daily Menus -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted">Daily Menus</h6>
                            <h2 class="fw-bold mb-0">
                                @ViewBag.DailyMenus
                            </h2>
                        </div>
                        <div class="fs-1 text-warning">
                            <i class="bi bi-egg-fried"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Meal Collections -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted">Meal Collections</h6>
                            <h2 class="fw-bold mb-0">
                                @ViewBag.MealCollections
                            </h2>
                        </div>
                        <div class="fs-1 text-info">
                            <i class="bi bi-basket-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Quick Actions -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <h4 class="fw-bold mb-3">Quick Actions</h4>

            <p class="text-muted mb-4">
                Quickly access important cafeteria management operations.
            </p>

            <div class="d-flex flex-wrap gap-3">

                <a asp-controller="StaffAccount"
                   asp-action="Create"
                   class="btn btn-success px-4 py-2">
                    <i class="bi bi-person-plus me-2"></i>
                    Create Staff Account
                </a>

            </div>

        </div>
    </div>

</div>
