@model smart_corporate_cafeteria_management.Models.FoodCategory

@{
    ViewData["Title"] = "Edit Food Category";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <div class="text-success fw-semibold small mb-1">
                🥕 CAFETERIA / FOOD CATEGORIES
            </div>
            <h2 class="fw-bold mb-1">Edit Food Category</h2>
            <p class="text-muted mb-0">
                Update your cafeteria food category information.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary rounded-3 px-3">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Categories
        </a>
    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <div style="height:8px;background:linear-gradient(90deg,#198754,#a3cfbb,#f6bd60);">
                </div>

                <div class="card-body p-4 p-lg-5">

                    <div class="d-flex align-items-center gap-3 mb-4">

                        <div class="rounded-4 d-flex align-items-center justify-content-center"
                             style="width:65px;height:65px;background:#e7f4e8;font-size:32px;">
                            🍽️
                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">
                                Update Category Information
                            </h5>
                            <p class="text-muted small mb-0">
                                Category ID: #@Model.CategoryID
                            </p>
                        </div>

                    </div>

                    <form asp-action="Edit"
                          asp-route-id="@Model.CategoryID"
                          method="post">

                        <input type="hidden" asp-for="CategoryID" />

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger rounded-3">
                        </div>

                        <div class="mb-4">
                            <label asp-for="CategoryName"
                                   class="form-label fw-semibold">
                                Category Name <span class="text-danger">*</span>
                            </label>

                            <input asp-for="CategoryName"
                                   class="form-control form-control-lg rounded-3"
                                   placeholder="Enter category name" />

                            <span asp-validation-for="CategoryName"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description"
                                   class="form-label fw-semibold">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control rounded-3"
                                      rows="4"
                                      placeholder="Write a short description..."></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger small">
                            </span>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex flex-wrap gap-2 justify-content-end">

                            <a asp-action="Index"
                               class="btn btn-light border rounded-3 px-4">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-success rounded-3 px-4">
                                <i class="bi bi-check-circle me-1"></i>
                                Update Category
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm rounded-4 h-100"
                 style="background:#f0f8ed;">

                <div class="card-body p-4">

                    <div class="text-center py-3">
                        <div style="font-size:65px;">🥕 🥒 🥬</div>

                        <h5 class="fw-bold mt-3">
                            Keep Your Kitchen Organized!
                        </h5>

                        <p class="text-muted small">
                            Make sure each category has a clear name
                            and useful description.
                        </p>
                    </div>

                    <hr />

                    <h6 class="fw-bold mb-3">
                        Editing Guidelines
                    </h6>

                    <div class="d-flex gap-2 mb-3">
                        <span>🍚</span>
                        <small class="text-muted">
                            Use clear food category names.
                        </small>
                    </div>

                    <div class="d-flex gap-2 mb-3">
                        <span>🥗</span>
                        <small class="text-muted">
                            Keep descriptions short and meaningful.
                        </small>
                    </div>

                    <div class="d-flex gap-2">
                        <span>🌿</span>
                        <small class="text-muted">
                            Save your changes after reviewing them.
                        </small>
                    </div>

                </div>
            </div>

        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
