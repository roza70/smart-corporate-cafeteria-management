@model IEnumerable<smart_corporate_cafeteria_management.Models.DailyMenu>

@{
    ViewData["Title"] = "Daily Menu";
}

<div class="container-fluid mt-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Daily Menu</h2>
            <p class="text-muted">
                Manage daily cafeteria menus.
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">

            <a asp-controller="DailyMenu"
               asp-action="History"
               class="btn btn-outline-secondary">
                <i class="bi bi-clock-history me-2"></i>
                Menu History
            </a>

            <a asp-controller="DailyMenu"
               asp-action="Create"
               class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>
                Create New Menu
            </a>

        </div>
    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- Daily Menu Table -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Menu ID</th>
                            <th>Menu Date</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var menu in Model)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @menu.MenuID
                                    </td>

                                    <td>
                                        @menu.MenuDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @(menu.Description ?? "No description")
                                    </td>

                                    <!-- Menu Status -->
                                    <td>
                                        @if (menu.IsPublished)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Published
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Draft
                                            </span>
                                        }
                                    </td>

                                    <!-- Menu Actions -->
                                    <td>
                                        <div class="d-flex gap-2 flex-wrap">

                                            <a asp-controller="DailyMenu"
                                               asp-action="Details"
                                               asp-route-id="@menu.MenuID"
                                               class="btn btn-sm btn-outline-primary">
                                                View Details
                                            </a>

                                            <a asp-controller="DailyMenu"
                                               asp-action="AddFoodItems"
                                               asp-route-id="@menu.MenuID"
                                               class="btn btn-sm btn-success">
                                                + Add Food
                                            </a>

                                            @if (!menu.IsPublished)
                                            {
                                                <form asp-controller="DailyMenu"
                                                      asp-action="Publish"
                                                      asp-route-id="@menu.MenuID"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-primary">
                                                        <i class="bi bi-send me-1"></i>
                                                        Publish
                                                    </button>

                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-controller="DailyMenu"
                                                      asp-action="Unpublish"
                                                      asp-route-id="@menu.MenuID"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-secondary">
                                                        Unpublish
                                                    </button>

                                                </form>
                                            }

                                            <a asp-controller="DailyMenu"
                                               asp-action="Edit"
                                               asp-route-id="@menu.MenuID"
                                               class="btn btn-sm btn-outline-warning">
                                                Edit
                                            </a>

                                            <a asp-controller="DailyMenu"
                                               asp-action="Delete"
                                               asp-route-id="@menu.MenuID"
                                               class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </a>

                                        </div>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center text-muted py-4">
                                    <i class="bi bi-calendar-x fs-3 d-block mb-2"></i>
                                    No daily menus found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>
