@model smart_corporate_cafeteria_management.Models.Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Delete Employee</h2>
        <p class="text-muted mb-0">
            Review employee information before deleting the record.
        </p>
    </div>

    <div class="row">
        <div class="col-lg-8 col-xl-7">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4">

                    <!-- Warning -->
                    <div class="d-flex align-items-start p-3 rounded-3 bg-danger bg-opacity-10 mb-4">

                        <i class="bi bi-exclamation-triangle-fill text-danger fs-3 me-3"></i>

                        <div>
                            <h5 class="fw-bold text-danger mb-1">
                                Are you sure?
                            </h5>

                            <p class="text-muted mb-0">
                                You are about to permanently delete this employee.
                                This action cannot be undone.
                            </p>
                        </div>

                    </div>

                    <!-- Employee Information -->
                    <div class="d-flex align-items-center mb-4">

                        <div class="rounded-circle bg-primary bg-opacity-10
                            text-primary d-flex align-items-center
                            justify-content-center fw-bold fs-4 me-3"
                             style="width: 60px; height: 60px;">

                            @(string.IsNullOrWhiteSpace(Model.EmployeeName)
                                ? "?"
                                : Model.EmployeeName.Substring(0, 1).ToUpper())

                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">
                                @Model.EmployeeName
                            </h5>

                            <span class="text-muted small">
                                Employee #@Model.EmployeeId
                            </span>
                        </div>

                    </div>

                    <hr />

                    <h6 class="fw-bold mb-3">
                        Employee Information
                    </h6>

                    <div class="row mb-3">

                        <div class="col-sm-4 text-muted">
                            Employee ID
                        </div>

                        <div class="col-sm-8 fw-semibold">
                            #@Model.EmployeeId
                        </div>

                    </div>

                    <div class="row mb-3">

                        <div class="col-sm-4 text-muted">
                            Employee Name
                        </div>

                        <div class="col-sm-8 fw-semibold">
                            @Model.EmployeeName
                        </div>

                    </div>

                    <div class="row mb-3">

                        <div class="col-sm-4 text-muted">
                            Email Address
                        </div>

                        <div class="col-sm-8">
                            @Model.Email
                        </div>

                    </div>

                    <div class="row mb-3">

                        <div class="col-sm-4 text-muted">
                            Phone Number
                        </div>

                        <div class="col-sm-8">
                            @Model.Phone
                        </div>

                    </div>

                    <div class="row mb-4">

                        <div class="col-sm-4 text-muted">
                            Department
                        </div>

                        <div class="col-sm-8">
                            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2">
                                @(Model.Department?.DepartmentName ?? "Not Assigned")
                            </span>
                        </div>

                    </div>

                    <hr />

                    <!-- Confirmation Buttons -->
                    <form asp-action="Delete"
                          asp-route-id="@Model.EmployeeId"
                          method="post">

                        <input type="hidden" asp-for="EmployeeId" />

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-light border px-4">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-danger px-4">

                                <i class="bi bi-trash me-2"></i>
                                Confirm Delete

                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
