@model smart_corporate_cafeteria_management.Models.FoodItem

@{
    ViewData["Title"] = "Delete Food Item";
}

<div class="container-fluid py-4 food-page">

    <div class="food-page-header mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <div class="food-eyebrow mb-2">
                    KITCHEN MANAGEMENT / FOOD ITEMS
                </div>
                <h2 class="fw-bold mb-2">Delete Food Item</h2>
                <p class="text-muted mb-0">
                    Review the food item before deleting it.
                </p>
            </div>

            <a asp-action="Index" class="btn btn-outline-success px-4 py-2">
                <i class="bi bi-arrow-left me-2"></i>
                Back to Food Items
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">

            <div class="food-table-card">

                <div class="p-4 border-bottom">
                    <div class="d-flex align-items-center gap-3">
                        <div class="food-summary-icon food-icon-green">
                            <i class="bi bi-trash3"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1">Confirm Food Item Deletion</h5>
                            <small class="text-muted">
                                Please review the information below.
                            </small>
                        </div>
                    </div>
                </div>

                <div class="p-4">

                    <div class="alert alert-warning" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Are you sure you want to delete this food item?
                        This action cannot be undone.
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted small fw-semibold">
                            FOOD NAME
                        </label>
                        <h4 class="fw-bold">@Model.FoodName</h4>
                    </div>

                    <hr />

                    <div class="mb-4">
                        <label class="form-label text-muted small fw-semibold">
                            FOOD CATEGORY
                        </label>
                        <p class="fw-semibold mb-0">
                            @(Model.FoodCategory?.CategoryName ?? "Not assigned")
                        </p>
                    </div>

                    <hr />

                    <div class="mb-4">
                        <label class="form-label text-muted small fw-semibold">
                            DESCRIPTION
                        </label>
                        <p class="mb-0">
                            @(string.IsNullOrWhiteSpace(Model.Description)
                                ? "No description available."
                                : Model.Description)
                        </p>
                    </div>

                    <hr />

                    <div class="mb-4">
                        <label class="form-label text-muted small fw-semibold">
                            STATUS
                        </label>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </div>

                    <div class="d-flex justify-content-end flex-wrap gap-2 pt-3 border-top">

                        <a asp-action="Index"
                           class="btn btn-light border px-4">
                            Cancel
                        </a>

                        <form asp-action="Delete"
                              asp-route-id="@Model.FoodItemId"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-danger px-4">
                                <i class="bi bi-trash3 me-2"></i>
                                Confirm Delete
                            </button>

                        </form>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
