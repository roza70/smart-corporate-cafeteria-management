@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .access-denied {
        min-height: 65vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 25px;
    }

    .denied-card {
        max-width: 520px;
        width: 100%;
        background: white;
        border: 1px solid #F0E6DE;
        border-radius: 20px;
        padding: 40px 30px;
        text-align: center;
        box-shadow: 0 10px 35px rgba(50, 40, 30, .06);
    }

    .denied-icon {
        width: 85px;
        height: 85px;
        border-radius: 50%;
        background: #FFF0E5;
        color: #A94730;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 38px;
        margin: 0 auto 22px;
    }

    .denied-card h2 {
        color: #244B36;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .denied-card p {
        color: #8B817A;
        font-size: 14px;
        line-height: 1.7;
    }

    .denied-btn {
        display: inline-block;
        background: #A94730;
        color: white;
        padding: 11px 22px;
        border-radius: 9px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        margin-top: 12px;
    }

        .denied-btn:hover {
            background: #783020;
            color: white;
        }
</style>

<div class="access-denied">

    <div class="denied-card">

        <div class="denied-icon">
            <i class="bi bi-shield-lock-fill"></i>
        </div>

        <h2>Access Denied</h2>

        <p>
            Sorry! You don't have permission to access this page.
            Please contact your system administrator if you
            believe this is a mistake.
        </p>

        <a asp-controller="Account"
           asp-action="Login"
           class="denied-btn">

            <i class="bi bi-box-arrow-in-right me-2"></i>
            Back to Login

        </a>

    </div>

</div>
