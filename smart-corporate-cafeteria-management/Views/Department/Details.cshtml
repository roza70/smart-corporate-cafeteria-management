@model smart_corporate_cafeteria_management.Models.Department

@{
    ViewData["Title"] = "Department Details";

    var employees = Model.Employees
        ?? new List<smart_corporate_cafeteria_management.Models.Employee>();
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Department Details</h2>
            <p class="text-muted mb-0">
                View department information and assigned employees.
            </p>
        </div>

        <div class="mt-3 mt-md-0">
            <a asp-action="Index"
               class="btn btn-outline-secondary me-2">
                <i class="bi bi-arrow-left me-1"></i>
                Back to List
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.DepartmentId"
               class="btn btn-primary">
                <i class="bi bi-pencil-square me-1"></i>
                Edit Department
            </a>
            <a asp-action="Delete"
               asp-route-id="@Model.DepartmentId"
               class="btn btn-danger">
                <i class="bi bi-trash me-1"></i>
                Delete Department
            </a>

        </div>
    </div>

    <div class="row g-4">

        <!-- Department Information -->
        <div class="col-lg-5">

            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <div class="d-flex align-items-center mb-4">

                        <div class="rounded-3 bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center me-3"
                             style="width:65px; height:65px; font-size:28px;">
                            <i class="bi bi-building"></i>
                        </div>

                        <div>
                            <h4 class="fw-bold mb-1">
                                @Model.DepartmentName
                            </h4>

                            <span class="badge bg-success bg-opacity-10 text-success">
                                Active Department
                            </span>
                        </div>

                    </div>

                    <hr />

                    <!-- Department ID -->
                    <div class="mb-4">
                        <small class="text-muted d-block mb-1">
                            Department ID
                        </small>

                        <h6 class="fw-semibold">
                            #@Model.DepartmentId
                        </h6>
                    </div>

                    <!-- Department Name -->
                    <div class="mb-4">
                        <small class="text-muted d-block mb-1">
                            Department Name
                        </small>

                        <h6 class="fw-semibold">
                            @Model.DepartmentName
                        </h6>
                    </div>

                    <!-- Description -->
                    <div class="mb-4">
                        <small class="text-muted d-block mb-1">
                            Description
                        </small>

                        <p class="mb-0">
                            @(string.IsNullOrWhiteSpace(Model.Description)
                                ? "No description available."
                                : Model.Description)
                        </p>
                    </div>

                    <!-- Employee Count -->
                    <div class="rounded-3 bg-light p-3">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>
                                <small class="text-muted">
                                    Assigned Employees
                                </small>

                                <h3 class="fw-bold mb-0">
                                    @employees.Count
                                </h3>
                            </div>

                            <div class="text-primary fs-2">
                                <i class="bi bi-people"></i>
                            </div>

                        </div>

                    </div>

                </div>
            </div>

        </div>

        <!-- Assigned Employees -->
        <div class="col-lg-7">

            <div class="card border-0 shadow-sm h-100">

                <!-- Card Header -->
                <div class="card-header bg-white border-0 p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h5 class="fw-bold mb-1">
                                Assigned Employees
                            </h5>

                            <p class="text-muted small mb-0">
                                Employees belonging to this department.
                            </p>
                        </div>

                        <span class="badge bg-primary bg-opacity-10 text-primary">
                            @employees.Count Employees
                        </span>

                    </div>

                </div>

                <!-- Employee List -->
                <div class="card-body p-0">

                    @if (employees.Any())
                    {
                        <div class="table-responsive">

                            <table class="table align-middle mb-0">

                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Employee</th>
                                        <th>Email</th>
                                        <th>Phone</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var employee in employees)
                                    {
                                        <tr>

                                            <!-- Employee Name -->
                                            <td class="ps-4">

                                                <div class="d-flex align-items-center">

                                                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center me-2 fw-bold"
                                                         style="width:38px; height:38px; min-width:38px;">

                                                        @(string.IsNullOrWhiteSpace(employee.EmployeeName)
                                                            ? "?"
                                                            : employee.EmployeeName.Substring(0, 1).ToUpper())

                                                    </div>

                                                    <span class="fw-semibold">
                                                        @employee.EmployeeName
                                                    </span>

                                                </div>

                                            </td>

                                            <!-- Email -->
                                            <td>
                                                <span class="text-muted">
                                                    @(string.IsNullOrWhiteSpace(employee.Email)
                                                        ? "Not provided"
                                                        : employee.Email)
                                                </span>
                                            </td>

                                            <!-- Phone -->
                                            <td>
                                                <span class="text-muted">
                                                    @(string.IsNullOrWhiteSpace(employee.Phone)
                                                        ? "Not provided"
                                                        : employee.Phone)
                                                </span>
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 px-3">

                            <i class="bi bi-people text-muted"
                               style="font-size:45px;"></i>

                            <h6 class="fw-bold mt-3">
                                No Employees Assigned
                            </h6>

                            <p class="text-muted small mb-0">
                                There are currently no employees in this department.
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>
