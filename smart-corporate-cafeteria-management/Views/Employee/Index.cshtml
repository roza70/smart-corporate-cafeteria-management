@model IEnumerable<smart_corporate_cafeteria_management.Models.Employee>

@{
    ViewData["Title"] = "Employee Management";
    var employees = Model?.ToList() ?? new List<smart_corporate_cafeteria_management.Models.Employee>();
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Employee Management</h2>
            <p class="text-muted mb-0">
                Manage employees, departments and employee information.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary px-4 py-2 mt-3 mt-md-0">
            + Add New Employee
        </a>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <p class="text-muted mb-2">Total Employees</p>
                    <h2 class="fw-bold mb-0">@employees.Count</h2>
                    <small class="text-success">Registered employees</small>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <p class="text-muted mb-2">Departments</p>
                    
                    <h2 class="fw-bold mb-0">
                        @(employees
                            .Where(e => e.Department != null)
                            .Select(e => e.Department!.DepartmentId)
                            .Distinct()
                            .Count())
                    </h2>

                    <small class="text-primary">Departments represented</small>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <p class="text-muted mb-2">Employee Records</p>
                    <h2 class="fw-bold mb-0">@employees.Count</h2>
                    <small class="text-muted">Available records</small>
                </div>
            </div>
        </div>

    </div>

    <!-- Employee Table Card -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4">

            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
                <div>
                    <h5 class="fw-bold mb-1">Employee Directory</h5>
                    <p class="text-muted small mb-0">
                        View and manage all registered employees.
                    </p>
                </div>

                <div class="mt-3 mt-md-0">
                    <input type="text"
                           id="employeeSearch"
                           class="form-control"
                           placeholder="Search employees..."
                           style="min-width:250px;" />
                </div>
            </div>

            <div class="table-responsive">

                <table class="table align-middle table-hover" id="employeeTable">

                    <thead class="table-light">
                        <tr>
                            <th>Employee ID</th>
                            <th>Employee</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Department</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (employees.Any())
                        {
                            @foreach (var employee in employees)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">
                                            #@employee.EmployeeId
                                        </span>
                                    </td>

                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center me-2 fw-bold"
                                                 style="width:38px;height:38px;">
                                                @(string.IsNullOrWhiteSpace(employee.EmployeeName)
                                                    ? "?"
                                                    : employee.EmployeeName.Substring(0, 1).ToUpper())
                                            </div>

                                            <span class="fw-semibold">
                                                @employee.EmployeeName
                                            </span>
                                        </div>
                                    </td>

                                    <td>@employee.Email</td>

                                    <td>@employee.Phone</td>

                                    <td>
                                        <span class="badge bg-light text-primary border">
                                            @(employee.Department?.DepartmentName ?? "Unassigned")
                                        </span>
                                    </td>

                                    <td class="text-center text-nowrap">

                                        <a asp-action="Details"
                                           asp-route-id="@employee.EmployeeId"
                                           class="btn btn-sm btn-outline-info me-1">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@employee.EmployeeId"
                                           class="btn btn-sm btn-outline-primary me-1">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@employee.EmployeeId"
                                           class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </a>

                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <h5 class="text-muted">No Employees Found</h5>
                                    <p class="text-muted mb-3">
                                        Start by adding your first employee.
                                    </p>
                                    <a asp-action="Create" class="btn btn-primary">
                                        Add Employee
                                    </a>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

                <p id="noSearchResults" class="text-center text-muted py-3 d-none">
                    No matching employees found.
                </p>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            const searchInput = document.getElementById("employeeSearch");
            const tableRows = document.querySelectorAll("#employeeTable tbody tr");
            const noResults = document.getElementById("noSearchResults");

            searchInput.addEventListener("input", function() {

                const searchValue = searchInput.value.toLowerCase().trim();
                let visibleCount = 0;

                tableRows.forEach(function(row) {

                    const rowText = row.innerText.toLowerCase();
                    const matches = rowText.includes(searchValue);

                    row.style.display = matches ? "" : "none";

                    if (matches) {
                        visibleCount++;
                    }
                });

                noResults.classList.toggle(
                    "d-none",
                    visibleCount > 0 || tableRows.length === 0
                );
            });

        });
    </script>
}
