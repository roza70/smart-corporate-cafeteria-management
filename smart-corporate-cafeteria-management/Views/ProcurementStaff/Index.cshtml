@{
    ViewData["Title"] = "Procurement Dashboard";
}

<div class="container-fluid py-4">

    <div class="p-4 mb-4 rounded-4 text-white"
         style="background: linear-gradient(120deg, #344b83, #5276bd);">
        <h2 class="fw-bold">Procurement Dashboard</h2>
        <p class="mb-0">Manage suppliers, grocery purchases and procurement payments.</p>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total Suppliers</h6>
                    <h2 class="fw-bold">—</h2>
                    <small class="text-muted">Supplier records</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Purchase Orders</h6>
                    <h2 class="fw-bold">—</h2>
                    <small class="text-muted">Purchase order records</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Grocery Purchases</h6>
                    <h2 class="fw-bold">—</h2>
                    <small class="text-muted">Ingredient purchases</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Purchase Payments</h6>
                    <h2 class="fw-bold">—</h2>
                    <small class="text-muted">Procurement expenses</small>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-4">

        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-3">Procurement Operations</h4>

                    <div class="list-group list-group-flush">
                        <div class="list-group-item py-3">
                            <strong>Supplier Management</strong>
                            <p class="text-muted mb-0">Manage supplier information and contact details.</p>
                        </div>

                        <div class="list-group-item py-3">
                            <strong>Grocery & Ingredient Purchasing</strong>
                            <p class="text-muted mb-0">Manage rice, vegetables, meat, fish, dal and other ingredients.</p>
                        </div>

                        <div class="list-group-item py-3">
                            <strong>Purchase Order Management</strong>
                            <p class="text-muted mb-0">Create and track grocery purchase orders.</p>
                        </div>

                        <div class="list-group-item py-3">
                            <strong>Purchase Payment Management</strong>
                            <p class="text-muted mb-0">Record and monitor payments made to suppliers.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-3">Procurement Guidelines</h4>

                    <ul class="text-muted">
                        <li class="mb-2">Verify supplier information before purchasing.</li>
                        <li class="mb-2">Record ingredient quantities and prices accurately.</li>
                        <li class="mb-2">Track every purchase order.</li>
                        <li class="mb-2">Keep payment records for every purchase.</li>
                        <li class="mb-2">Coordinate grocery requirements with Kitchen Staff.</li>
                    </ul>
                </div>
            </div>
        </div>

    </div>

</div>
