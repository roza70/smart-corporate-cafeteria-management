@model smart_corporate_cafeteria_management.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login | Smart Cafeteria</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
        :root {
            --green: #286344;
            --green-dark: #194b32;
            --green-light: #e9f2e9;
            --cream: #faf8f0;
            --text: #24352b;
            --muted: #829087;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: var(--cream);
            font-family: 'DM Sans', sans-serif;
            color: var(--text);
        }

        .login-layout {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1.08fr 0.92fr;
        }

        /* Kitchen visual panel */
        .kitchen-panel {
            position: relative;
            overflow: hidden;
            min-height: 100vh;
            padding: 45px 55px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            color: white;
            background: linear-gradient(145deg, rgba(20, 65, 43, .94), rgba(40, 99, 68, .78)), radial-gradient(circle at 80% 20%, #b5c98b, transparent 40%);
        }

            .kitchen-panel::before {
                content: "🥬";
                position: absolute;
                font-size: 230px;
                right: 7%;
                top: 20%;
                opacity: .13;
                transform: rotate(-18deg);
            }

            .kitchen-panel::after {
                content: "🥕";
                position: absolute;
                font-size: 170px;
                right: 25%;
                bottom: 13%;
                opacity: .14;
                transform: rotate(20deg);
            }

        .brand {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: 13px;
            font-size: 19px;
            font-weight: 700;
            letter-spacing: .2px;
        }

        .brand-icon {
            width: 46px;
            height: 46px;
            display: grid;
            place-items: center;
            border-radius: 14px;
            background: rgba(255,255,255,.16);
            font-size: 25px;
        }

        .hero-content {
            position: relative;
            z-index: 1;
            max-width: 520px;
            margin-top: -35px;
        }

        .eyebrow {
            display: inline-block;
            padding: 8px 14px;
            border: 1px solid rgba(255,255,255,.28);
            border-radius: 30px;
            font-size: 12px;
            letter-spacing: 1.3px;
            text-transform: uppercase;
            margin-bottom: 22px;
        }

        .hero-content h1 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(38px, 4.5vw, 62px);
            line-height: 1.15;
            margin-bottom: 20px;
        }

        .hero-content p {
            max-width: 430px;
            color: rgba(255,255,255,.82);
            font-size: 16px;
            line-height: 1.8;
        }

        .food-tags {
            position: relative;
            z-index: 1;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

            .food-tags span {
                padding: 10px 15px;
                border-radius: 30px;
                background: rgba(255,255,255,.13);
                border: 1px solid rgba(255,255,255,.17);
                font-size: 13px;
            }

        /* Login panel */
        .login-panel {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 45px 30px;
            background: var(--cream);
        }

        .login-card {
            width: 100%;
            max-width: 430px;
        }

        .mobile-brand {
            display: none;
            color: var(--green);
            font-weight: 700;
            margin-bottom: 35px;
        }

        .welcome-label {
            color: var(--green);
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        .login-card h2 {
            font-family: 'Playfair Display', serif;
            font-size: 36px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .subtitle {
            color: var(--muted);
            margin-bottom: 32px;
            font-size: 14px;
            line-height: 1.7;
        }

        .form-label {
            font-weight: 600;
            font-size: 13px;
            margin-bottom: 9px;
        }

        .form-control {
            height: 52px;
            border: 1px solid #e0e6dd;
            background: white;
            border-radius: 11px;
            padding: 12px 15px;
            font-size: 14px;
        }

            .form-control:focus {
                border-color: var(--green);
                box-shadow: 0 0 0 4px rgba(40,99,68,.10);
            }

        .form-check-input:checked {
            background-color: var(--green);
            border-color: var(--green);
        }

        .form-check-label {
            color: #68766c;
            font-size: 13px;
        }

        .btn-login {
            height: 53px;
            border: none;
            border-radius: 11px;
            background: var(--green);
            color: white;
            font-weight: 700;
            letter-spacing: .3px;
            transition: .25s;
        }

            .btn-login:hover {
                background: var(--green-dark);
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(40,99,68,.18);
            }

        .login-footer {
            margin-top: 35px;
            padding-top: 22px;
            border-top: 1px solid #e8e9df;
            text-align: center;
            color: #9aa399;
            font-size: 11px;
            line-height: 1.8;
        }

        @@media (max-width: 900px) {
            .login-layout {
                grid-template-columns: 1fr;
            }

            .kitchen-panel {
                display: none;
            }

            .login-panel {
                min-height: 100vh;
                padding: 35px 22px;
            }

            .mobile-brand {
                display: block;
            }
        }

        @@media (max-width: 480px) {
            .login-card h2 {
                font-size: 31px;
            }

            .login-panel {
                padding: 25px 20px;
            }
        }
    </style>
</head>

<body>
    <main class="login-layout">

        <section class="kitchen-panel">

            <div class="brand">
                <div class="brand-icon">🍃</div>
                <span>Smart Cafeteria</span>
            </div>

            <div class="hero-content">
                <span class="eyebrow">Fresh • Healthy • Delicious</span>

                <h1>
                    Good Food.<br />
                    Better Workdays.
                </h1>

                <p>
                    A smarter way to manage corporate meals,
                    kitchen operations and fresh daily menus.
                    Bringing people together, one healthy meal at a time.
                </p>
            </div>

            <div class="food-tags">
                <span>🥗 Fresh Salad</span>
                <span>🥕 Healthy Ingredients</span>
                <span>🍲 Daily Meals</span>
            </div>

        </section>

        <section class="login-panel">

            <div class="login-card">

                <div class="mobile-brand">
                    🍃 Smart Cafeteria
                </div>

                <div class="welcome-label">Welcome Back</div>

                <h2>Sign in to your account</h2>

                <p class="subtitle">
                    Access your cafeteria workspace and manage
                    your daily activities.
                </p>

                <form asp-controller="Account"
                      asp-action="Login"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="returnUrl"
                           value="@ViewData["ReturnUrl"]" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-4">
                        <label asp-for="Email"
                               class="form-label">Email Address</label>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="name@company.com"
                               autocomplete="username" />

                        <span asp-validation-for="Email"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password"
                               class="form-label">Password</label>

                        <input asp-for="Password"
                               class="form-control"
                               placeholder="Enter your password"
                               autocomplete="current-password" />

                        <span asp-validation-for="Password"
                              class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe"
                               class="form-check-input" />

                        <label asp-for="RememberMe"
                               class="form-check-label">
                            Remember me
                        </label>
                    </div>

                    <button type="submit"
                            class="btn btn-login w-100">
                        Sign In <span class="ms-2">→</span>
                    </button>

                </form>

                <div class="login-footer">
                    © 2026 Smart Corporate Cafeteria Management System
                    <br />
                    Fresh meals. Smarter management. Better service.
                </div>

            </div>
        </section>

    </main>
</body>
</html>
