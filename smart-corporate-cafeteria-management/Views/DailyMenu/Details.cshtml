@model smart_corporate_cafeteria_management.Models.DailyMenu

@{
    ViewData["Title"] = "Menu Details";
}

<div class="container mt-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Menu Details</h2>
            <p class="text-muted">
                Complete food menu for the selected date.
            </p>
        </div>

        <a asp-controller="DailyMenu"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Menu List
        </a>
    </div>

    <!-- Menu Information -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">Menu Information</h5>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <small class="text-muted">Menu ID</small>
                    <h5>@Model.MenuID</h5>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted">Menu Date</small>
                    <h5>@Model.MenuDate.ToString("dd MMMM yyyy")</h5>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted">Total Food Items</small>
                    <h5>@Model.DailyMenuItems.Count</h5>
                </div>
            </div>

            <div>
                <small class="text-muted">Description</small>
                <p class="mb-0">
                    @(Model.Description ?? "No description available")
                </p>
            </div>

        </div>
    </div>

    <!-- Food Items -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">Food Items</h5>

            @if (Model.DailyMenuItems.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>SL</th>
                                <th>Food Item ID</th>
                                <th>Food Name</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                int serial = 1;
                            }

                            @foreach (var item in Model.DailyMenuItems)
                            {
                                <tr>
                                    <td>@serial</td>
                                    <td>@item.FoodItemID</td>
                                    <td class="fw-semibold">
                                        @(item.FoodItem?.FoodName ?? "Unknown Food")
                                    </td>
                                </tr>

                                serial++;
                            }

                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-4">
                    No food items have been added to this menu yet.
                </div>
            }

        </div>
    </div>

</div>
