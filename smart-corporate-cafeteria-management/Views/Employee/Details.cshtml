@model smart_corporate_cafeteria_management.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<h2>Employee Details</h2>

<hr />

<div class="row">
    <div class="col-md-6">

        <dl class="row">

            <dt class="col-sm-4">
                Employee ID
            </dt>
            <dd class="col-sm-8">
                @Model.EmployeeId
            </dd>

            <dt class="col-sm-4">
                Employee Name
            </dt>
            <dd class="col-sm-8">
                @Model.EmployeeName
            </dd>

            <dt class="col-sm-4">
                Email
            </dt>
            <dd class="col-sm-8">
                @Model.Email
            </dd>

            <dt class="col-sm-4">
                Phone
            </dt>
            <dd class="col-sm-8">
                @Model.Phone
            </dd>

            <dt class="col-sm-4">
                Department
            </dt>
            <dd class="col-sm-8">
                @Model.Department?.DepartmentName
            </dd>

        </dl>

        <a asp-action="Edit"
           asp-route-id="@Model.EmployeeId"
           class="btn btn-primary">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to List
        </a>

    </div>
</div>
