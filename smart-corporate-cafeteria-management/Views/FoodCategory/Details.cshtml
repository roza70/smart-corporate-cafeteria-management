@model smart_corporate_cafeteria_management.Models.FoodCategory

@{
    ViewData["Title"] = "Category Details";

    var foodCount = Model.FoodItems?.Count ?? 0;
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <div class="text-success fw-semibold small mb-1">
                🥕 CAFETERIA / FOOD CATEGORIES
            </div>
            <h2 class="fw-bold mb-1">Category Details</h2>
            <p class="text-muted mb-0">
                View complete information about this food category.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary rounded-3 px-3">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Categories
        </a>
    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <div style="height: 8px; background: linear-gradient(90deg, #198754, #a3cfbb, #f6bd60);">
                </div>

                <div class="card-body p-4 p-lg-5">

                    <div class="d-flex align-items-center gap-3 mb-4">

                        <div class="rounded-4 d-flex align-items-center justify-content-center"
                             style="width:75px;height:75px;background:#e7f4e8;font-size:36px;">
                            🍽️
                        </div>

                        <div>
                            <span class="badge bg-success-subtle text-success mb-2">
                                <i class="bi bi-check-circle me-1"></i>
                                Registered
                            </span>

                            <h3 class="fw-bold mb-0">
                                @Model.CategoryName
                            </h3>

                            <small class="text-muted">
                                Category ID: #@Model.CategoryID
                            </small>
                        </div>

                    </div>

                    <hr class="my-4" />

                    <div class="mb-4">
                        <label class="text-muted small fw-semibold mb-2">
                            CATEGORY NAME
                        </label>
                        <div class="fs-5 fw-semibold">
                            @Model.CategoryName
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="text-muted small fw-semibold mb-2">
                            DESCRIPTION
                        </label>
                        <div class="text-secondary">
                            @(string.IsNullOrWhiteSpace(Model.Description)
                                ? "No description available."
                                : Model.Description)
                        </div>
                    </div>

                    <div class="row g-3 mt-2">

                        <div class="col-md-6">
                            <div class="rounded-4 p-3"
                                 style="background:#eef7ee;">
                                <div class="text-muted small mb-1">
                                    FOOD ITEMS
                                </div>
                                <div class="fs-3 fw-bold text-success">
                                    @foodCount
                                </div>
                                <small class="text-muted">
                                    Items in this category
                                </small>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="rounded-4 p-3"
                                 style="background:#fff5e8;">
                                <div class="text-muted small mb-1">
                                    CATEGORY STATUS
                                </div>
                                <div class="fs-5 fw-bold text-success">
                                    Active
                                </div>
                                <small class="text-muted">
                                    Available in the system
                                </small>
                            </div>
                        </div>

                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <a asp-action="Edit"
                           asp-route-id="@Model.CategoryID"
                           class="btn btn-success rounded-3 px-4">
                            <i class="bi bi-pencil-square me-1"></i>
                            Edit Category
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@Model.CategoryID"
                           class="btn btn-outline-danger rounded-3 px-4">
                            <i class="bi bi-trash me-1"></i>
                            Delete Category
                        </a>
                    </div>

                </div>
            </div>

        </div>

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm rounded-4 h-100"
                 style="background:#f0f8ed;">

                <div class="card-body p-4">

                    <div class="text-center py-3">
                        <div style="font-size:65px;">🥕 🥒 🥬</div>

                        <h5 class="fw-bold mt-3">
                            Fresh Kitchen, Smart Management!
                        </h5>

                        <p class="text-muted small">
                            Keep your cafeteria food items organized
                            with meaningful categories.
                        </p>
                    </div>

                    <hr />

                    <h6 class="fw-bold mb-3">
                        Category Overview
                    </h6>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Category ID</span>
                        <strong>#@Model.CategoryID</strong>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Food Items</span>
                        <strong>@foodCount</strong>
                    </div>

                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Status</span>
                        <span class="text-success fw-semibold">Registered</span>
                    </div>

                </div>
            </div>

        </div>

    </div>
</div>
