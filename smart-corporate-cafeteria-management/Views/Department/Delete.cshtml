@model smart_corporate_cafeteria_management.Models.Department

@{
    ViewData["Title"] = "Delete Department";
    var employeeCount = Model.Employees?.Count ?? 0;
    var canDelete = employeeCount == 0;
}

<div class="container-fluid px-0">

    <!-- Page Header -->
    <div class="mb-4">
        <h4 class="fw-bold mb-1">Delete Department</h4>
        <p class="text-muted mb-0">
            Review department information before deletion.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-4">

                <!-- Warning Header -->
                <div class="card-body p-4">

                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                             style="width:75px;height:75px;background:#fff0f0;color:#dc3545;">
                            <i class="bi bi-exclamation-triangle-fill fs-2"></i>
                        </div>

                        <h5 class="fw-bold">Confirm Department Deletion</h5>

                        <p class="text-muted mb-0">
                            Are you sure you want to delete this department?
                        </p>
                    </div>

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>

                    <!-- Department Information -->
                    <div class="rounded-3 p-4 mb-4"
                         style="background:#f7f8fc;">

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold mb-0">
                                <i class="bi bi-building me-2 text-primary"></i>
                                Department Information
                            </h6>

                            <span class="badge bg-success-subtle text-success">
                                Active Department
                            </span>
                        </div>

                        <hr />

                        <div class="row g-3">

                            <div class="col-sm-6">
                                <small class="text-muted">Department ID</small>
                                <div class="fw-semibold">#@Model.DepartmentId</div>
                            </div>

                            <div class="col-sm-6">
                                <small class="text-muted">Department Name</small>
                                <div class="fw-semibold">@Model.DepartmentName</div>
                            </div>

                            <div class="col-12">
                                <small class="text-muted">Description</small>
                                <div class="fw-medium">
                                    @(Model.Description ?? "No description available")
                                </div>
                            </div>

                            <div class="col-12">
                                <small class="text-muted">Assigned Employees</small>

                                <div class="fw-bold fs-5">
                                    @employeeCount
                                    <span class="text-muted fs-6 fw-normal">
                                        Employees
                                    </span>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Deletion Warning -->
                    @if (canDelete)
                    {
                        <div class="alert alert-warning border-0 rounded-3">
                            <i class="bi bi-exclamation-circle-fill me-2"></i>
                            <strong>Warning:</strong>
                            This action cannot be undone. The department
                            record will be permanently deleted.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger border-0 rounded-3">
                            <i class="bi bi-shield-lock-fill me-2"></i>
                            <strong>Deletion Restricted:</strong>
                            This department has @employeeCount assigned employee(s).
                            Reassign or remove those employees before deleting
                            this department.
                        </div>
                    }

                    <!-- Actions -->
                    <form asp-action="Delete" method="post">

                        <input type="hidden" asp-for="DepartmentId" />

                        <div class="d-flex justify-content-end gap-2 flex-wrap">

                            <a asp-action="Index"
                               class="btn btn-light border px-4">
                                <i class="bi bi-arrow-left me-1"></i>
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-danger px-4"
                                    disabled="@(!canDelete)">
                                <i class="bi bi-trash me-1"></i>
                                Confirm Delete
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
